/* ========================================
   SIGHTIQ - MODERN UI STYLESHEET LIBRARY
   Premium Design System for Qt Applications
   ======================================== */

/* ===== COLOR PALETTE ===== */
/*
Primary Background Gradient: #0f2027 → #203a43 → #2c5364
Accent Cyan: #00d4ff
Accent Green: #00ff88
Primary Blue: #0c66ed
Dark Text: #0f2027
Light Text: #ffffff
*/

/* ===== DIALOG BACKGROUNDS ===== */
/* Dark Gradient Background */
QDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0f2027,
                                stop:0.5 #203a43,
                                stop:1 #2c5364);
}

/* Light Gradient Background (Alternative) */
.QDialog.light-theme {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #e0f7ff,
                                stop:0.5 #b8e2f2,
                                stop:1 #8fcde8);
}

/* ===== GLASSMORPHISM CARDS ===== */
QFrame.glass-card {
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 25px;
}

QFrame.glass-card-light {
    background: rgba(255, 255, 255, 0.8);
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 25px;
}

/* ===== INPUT FIELDS ===== */
/* Modern Semi-Transparent Input */
QLineEdit {
    background: rgba(255, 255, 255, 0.15);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    padding: 0 15px;
    color: white;
    font-family: 'Segoe UI', Arial;
    font-size: 14px;
}

QLineEdit:focus {
    background: rgba(255, 255, 255, 0.2);
    border: 2px solid #00d4ff;
}

QLineEdit::placeholder {
    color: rgba(255, 255, 255, 0.5);
}

/* Code/OTP Input - Monospace */
QLineEdit.code-input {
    background: rgba(255, 255, 255, 0.15);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    padding: 0 15px;
    color: #00ff88;
    font-family: 'Courier New', monospace;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 5px;
}

QLineEdit.code-input:focus {
    background: rgba(255, 255, 255, 0.2);
    border: 2px solid #00ff88;
}

/* ===== BUTTONS ===== */
/* Primary Button - Blue Gradient */
QPushButton.btn-primary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0c66ed,
                                stop:1 #00d4ff);
    color: white;
    border: none;
    border-radius: 12px;
    font-family: 'Segoe UI', Arial;
    font-size: 15px;
    font-weight: bold;
    padding: 12px 24px;
}

QPushButton.btn-primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0a52c7,
                                stop:1 #00b8e6);
}

QPushButton.btn-primary:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #083d94,
                                stop:1 #0099cc);
}

/* Success Button - Green Gradient */
QPushButton.btn-success {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #00ff88,
                                stop:1 #00d4aa);
    color: #0f2027;
    border: none;
    border-radius: 15px;
    font-family: 'Segoe UI', Arial;
    font-size: 15px;
    font-weight: bold;
    padding: 12px 24px;
}

QPushButton.btn-success:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #00e67a,
                                stop:1 #00bb99);
}

QPushButton.btn-success:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #00cc6f,
                                stop:1 #00a888);
}

/* Secondary Button - Transparent */
QPushButton.btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 15px;
    font-family: 'Segoe UI', Arial;
    font-size: 15px;
    font-weight: bold;
    padding: 12px 24px;
}

QPushButton.btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border: 2px solid rgba(255, 255, 255, 0.5);
}

QPushButton.btn-secondary:pressed {
    background: rgba(255, 255, 255, 0.15);
}

/* Danger Button - Red */
QPushButton.btn-danger {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ff4d4d,
                                stop:1 #cc0000);
    color: white;
    border: none;
    border-radius: 12px;
    font-family: 'Segoe UI', Arial;
    font-size: 15px;
    font-weight: bold;
    padding: 12px 24px;
}

QPushButton.btn-danger:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ff3333,
                                stop:1 #b30000);
}

/* ===== LABELS ===== */
/* Main Heading */
QLabel.heading-main {
    background: transparent;
    color: white;
    font-family: 'Segoe UI', Arial;
    font-size: 36px;
    font-weight: bold;
}

/* Section Heading with Accent */
QLabel.heading-section {
    background: transparent;
    color: #00d4ff;
    font-family: 'Segoe UI', Arial;
    font-size: 16px;
    font-weight: bold;
}

/* Field Label */
QLabel.label-field {
    background: transparent;
    color: rgba(255, 255, 255, 0.9);
    font-family: 'Segoe UI', Arial;
    font-size: 13px;
    font-weight: 600;
}

/* Subtitle/Secondary Text */
QLabel.text-secondary {
    background: transparent;
    color: rgba(255, 255, 255, 0.8);
    font-family: 'Segoe UI', Arial;
    font-size: 14px;
}

/* ===== COMBO BOXES ===== */
QComboBox {
    background: rgba(255, 255, 255, 0.15);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    padding: 8px 15px;
    color: white;
    font-family: 'Segoe UI', Arial;
    font-size: 14px;
}

QComboBox:hover {
    background: rgba(255, 255, 255, 0.2);
    border: 2px solid #00d4ff;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 8px solid white;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background: #1a2a35;
    color: white;
    border: 2px solid #00d4ff;
    border-radius: 8px;
    selection-background-color: #00d4ff;
    selection-color: #0f2027;
}

/* ===== TABLES ===== */
QTableWidget {
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    gridline-color: rgba(255, 255, 255, 0.1);
    color: white;
    font-family: 'Segoe UI', Arial;
}

QTableWidget::item {
    padding: 8px;
}

QTableWidget::item:selected {
    background: rgba(0, 212, 255, 0.3);
    color: white;
}

QHeaderView::section {
    background: rgba(0, 212, 255, 0.2);
    color: white;
    font-weight: bold;
    padding: 10px;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 2px solid #00d4ff;
}

/* ===== SCROLL BARS ===== */
QScrollBar:vertical {
    background: rgba(255, 255, 255, 0.05);
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: rgba(0, 212, 255, 0.5);
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(0, 212, 255, 0.8);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Horizontal */
QScrollBar:horizontal {
    background: rgba(255, 255, 255, 0.05);
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: rgba(0, 212, 255, 0.5);
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(0, 212, 255, 0.8);
}

/* ===== CHECKBOXES ===== */
QCheckBox {
    color: white;
    font-family: 'Segoe UI', Arial;
    font-size: 14px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.1);
}

QCheckBox::indicator:checked {
    background: #00d4ff;
    border-color: #00d4ff;
}

/* ===== RADIO BUTTONS ===== */
QRadioButton {
    color: white;
    font-family: 'Segoe UI', Arial;
    font-size: 14px;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.1);
}

QRadioButton::indicator:checked {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
                                fx:0.5, fy:0.5,
                                stop:0 #00d4ff,
                                stop:0.6 #00d4ff,
                                stop:0.7 transparent);
    border-color: #00d4ff;
}

/* ===== DIVIDERS ===== */
QFrame.divider-horizontal {
    background: rgba(255, 255, 255, 0.3);
    max-height: 2px;
    border: none;
}

QFrame.divider-vertical {
    background: rgba(255, 255, 255, 0.3);
    max-width: 2px;
    border: none;
}

/* ===== TOOLTIPS ===== */
QToolTip {
    background: #1a2a35;
    color: white;
    border: 2px solid #00d4ff;
    border-radius: 8px;
    padding: 8px;
    font-family: 'Segoe UI', Arial;
    font-size: 12px;
}

/* ===== MESSAGE BOXES ===== */
QMessageBox {
    background: #1a2a35;
    color: white;
}

QMessageBox QLabel {
    color: white;
    font-family: 'Segoe UI', Arial;
}

QMessageBox QPushButton {
    background: #0c66ed;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    min-width: 80px;
    font-weight: bold;
}

QMessageBox QPushButton:hover {
    background: #0a52c7;
}

/* ========================================
   USAGE EXAMPLES
   ======================================== */

/*
// In your .ui file or code, apply classes like:

<widget class="QFrame" name="myCard">
    <property name="styleSheet">
        <string>QFrame#myCard { ... glass-card styles ... }</string>
    </property>
</widget>

// Or in C++ code:
QPushButton *btn = new QPushButton("Click Me");
btn->setProperty("class", "btn-primary");

// Or directly:
myButton->setStyleSheet(// btn-primary styles from above);
*/
