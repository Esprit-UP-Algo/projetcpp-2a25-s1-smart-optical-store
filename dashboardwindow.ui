    margin-top: 20px;                      /* space for the title */
    color: white;                          /* title text color */
    font-weight: bold;
    font-size: 14px;
}

QGroupBox::title {
 border: 2px solid black;               /* black border, 2px wide */
    border-radius: 8px;     
background-color: rgb(41, 102, 148);
    subcontrol-origin: margin;
    subcontrol-position: top center;       /* title centered */
    padding: 2px 10px;
}</string>
