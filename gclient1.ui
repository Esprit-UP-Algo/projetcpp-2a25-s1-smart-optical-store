    color: #334155;
    font-weight: 600;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #f1f5f9;
}

QTableWidget::item:selected {
    background-color: #e0f2fe;
    color: #0369a1;
}

QTableWidget::item[data-status="overdue"] {
    background-color: #fee2e2;
    color: #b91c1c;
}

QTableWidget::item[data-status="soon"] {
    background-color: #fef3c7;
    color: #b45309;
}

QTableWidget::item[data-status="ok"] {
    background-color: #dcfce7;
    color: #166534;
}

QScrollBar:vertical {
    border: none;
    background: #f8fafc;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}</string>
