<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
  <class>GestionClients</class>
  <widget class="QMainWindow" name="GestionClients">
    <property name="geometry">
      <rect>
        <x>0</x>
        <y>0</y>
        <width>1200</width>
        <height>800</height>
      </rect>
    </property>
    <property name="windowTitle">
      <string>Gestion de Clients</string>
    </property>

    <widget class="QWidget" name="centralwidget">
      <property name="styleSheet">
        <string notr="true">
        QWidget { background-color: #b9e3f7; font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; font-size: 13px; color: #0f172a; }
        #sidebarFrame { background-color: #24587a; border-radius: 8px; padding-top: 12px; padding-bottom: 12px; min-height: 100%; }
        QLabel#sidebarHeader { background-color: #1b4966; color: white; font-weight: 700; padding: 10px 16px; border-radius: 12px; margin: 6px; min-width: 180px; max-height: 42px; }
        QPushButton#btnClients, QPushButton#btnProduit, QPushButton#btnVentes, QPushButton#btnEmployes, QPushButton#btnDashboard { background-color: #24587a; color: white; border: 2px solid #1b4a67; font-weight: bold; text-align: left; padding: 12px 20px; border-radius: 6px; min-width: 180px; margin: 6px; min-height: 56px; }
        QPushButton#btnClients { background-color: #357fa3; border: 2px solid #2d6f91; }
        QPushButton#btnProduit:hover, QPushButton#btnVentes:hover, QPushButton#btnEmployes:hover, QPushButton#btnClients:hover, QPushButton#btnDashboard:hover { background-color: #357fa3; }
        QLabel#mainTitle { font-size: 22px; font-weight: 800; color: #0f172a; background-color: #bfeafc; padding: 12px 20px; border-radius: 10px; border: 1px solid #89c3e2; }
        QPushButton { background-color: #48a4d6; color: white; border-radius: 6px; padding: 8px 14px; font-weight: 600; border: none; }
        QPushButton:hover { background-color: #5ab5e3; }
        QPushButton#btnDelete { background-color: #d64545; }
        QPushButton#btnDelete:hover { background-color: #b53030; }
        QPushButton#btnExport { background-color: #48b36b; }
        QPushButton#btnExport:hover { background-color: #3da25f; }
        QLineEdit, QComboBox, QDateEdit { background-color: white; border: 1px solid #89c3e2; border-radius: 6px; padding: 8px; color: #0f172a; min-height: 30px; }
        QLabel { font-weight: 600; color: #0f172a; }
        QTableWidget { background-color: white; gridline-color: #90caf9; selection-background-color: #48a4d6; selection-color: white; alternate-background-color: #e9f5fc; border: 1px solid #89c3e2; border-radius: 8px; }
        QHeaderView::section { background-color: #24587a; color: white; font-weight: bold; height: 28px; border: none; }
        QTabWidget::pane { border: 1px solid #89c3e2; border-radius: 6px; }
        QTabBar::tab { background: #e2e8f0; border-radius: 6px; padding: 10px 20px; margin: 4px; color: #0f172a; min-width: 140px; }
        QTabBar::tab:selected { background: #24587a; color: white; }
        QComboBox::drop-down, QDateEdit::drop-down { border: none; }
        QLabel#labelLogoTopRight { background-color: white; border-radius: 8px; border: 1px solid #89c3e2; padding: 3px; }
        </string>
      </property>

      <layout class="QHBoxLayout" name="mainLayoutRoot">
        <!-- SIDEBAR -->
        <item>
          <widget class="QFrame" name="sidebarFrame">
            <property name="frameShape">
              <enum>QFrame::StyledPanel</enum>
            </property>
            <layout class="QVBoxLayout" name="sidebarLayout">
              <item>
                <widget class="QLabel" name="sidebarHeader">
                  <property name="text"><string>📊 Tableau de bord</string></property>
                  <property name="alignment"><set>Qt::AlignCenter</set></property>
                </widget>
              </item>
              <item>
                <widget class="QPushButton" name="btnClients"><property name="text"><string>🧍 Clients</string></property></widget>
              </item>
              <item>
                <widget class="QPushButton" name="btnProduit"><property name="text"><string>📦 Produits</string></property></widget>
              </item>
              <item>
                <widget class="QPushButton" name="btnVentes"><property name="text"><string>💸 Ventes</string></property></widget>
              </item>
              <item>
                <widget class="QPushButton" name="btnEmployes"><property name="text"><string>👔 Employés</string></property></widget>
              </item>
              <item>
                <widget class="QPushButton" name="btnDashboard"><property name="text"><string>📊 Dashboard</string></property></widget>
              </item>
            </layout>
          </widget>
        </item>

        <!-- CONTENT AREA -->
        <item>
          <layout class="QVBoxLayout" name="contentAreaLayout">

            <!-- TOP BAR (titre + logo) -->
            <item>
              <layout class="QHBoxLayout" name="layoutTopBar">
                <item>
                  <widget class="QLabel" name="mainTitle">
                    <property name="text"><string>Gestion de Clients</string></property>
                  </widget>
                </item>

                <item>
                  <spacer name="horizontalSpacerTopBar">
                    <property name="orientation"><enum>Qt::Horizontal</enum></property>
                    <property name="sizeHint">
                      <size>
                        <width>20</width>
                        <height>20</height>
                      </size>
                    </property>
                  </spacer>
                </item>

                <item>
                  <widget class="QLabel" name="labelLogoTopRight">
                    <property name="minimumSize">
                      <size>
                        <width>50</width>
                        <height>50</height>
                      </size>
                    </property>
                    <property name="maximumSize">
                      <size>
                        <width>50</width>
                        <height>50</height>
                      </size>
                    </property>
                    <property name="pixmap"><pixmap>smart_logo.png</pixmap></property>
                    <property name="scaledContents"><bool>true</bool></property>
                    <property name="toolTip"><string>Logo</string></property>
                  </widget>
                </item>
              </layout>
            </item>

            <!-- TABS -->
            <item>
              <widget class="QTabWidget" name="tabWidgetMain">
                <property name="currentIndex"><number>0</number></property>

                <!-- Tab: Liste Clients -->
                <widget class="QWidget" name="tabListeClients">
                  <attribute name="title"><string>Liste Clients</string></attribute>
                  <layout class="QVBoxLayout" name="layoutListeClients">
                    <item>
                      <layout class="QHBoxLayout" name="layoutSearch">
                        <item>
                          <widget class="QLineEdit" name="lineEditSearch">
                            <property name="placeholderText"><string>🔍 Recherche par Nom, ID ou Téléphone...</string></property>
                          </widget>
                        </item>
                        <item>
                          <widget class="QLabel" name="labelFilter"><property name="text"><string>Filtrer :</string></property></widget>
                        </item>
                        <item>
                          <widget class="QComboBox" name="comboBoxTri">
                            <item><property name="text"><string>Nom A-Z</string></property></item>
                            <item><property name="text"><string>Nom Z-A</string></property></item>
                            <item><property name="text"><string>Date Inscription ↑</string></property></item>
                            <item><property name="text"><string>Date Inscription ↓</string></property></item>
                          </widget>
                        </item>
                      </layout>
                    </item>

                    <item>
                      <widget class="QTableWidget" name="tableWidgetClients">
                        <property name="columnCount"><number>9</number></property>
                        <column><property name="text"><string>ID</string></property></column>
                        <column><property name="text"><string>Nom</string></property></column>
                        <column><property name="text"><string>Prénom</string></property></column>
                        <column><property name="text"><string>Date Naissance</string></property></column>
                        <column><property name="text"><string>Sexe</string></property></column>
                        <column><property name="text"><string>Adresse</string></property></column>
                        <column><property name="text"><string>Téléphone</string></property></column>
                        <column><property name="text"><string>Email</string></property></column>
                        <column><property name="text"><string>Date Inscription</string></property></column>
                      </widget>
                    </item>

                    <item>
                      <layout class="QHBoxLayout" name="layoutButtons">
                        <item>
                          <widget class="QPushButton" name="btnExport"><property name="text"><string>📤 Exporter PDF</string></property></widget>
                        </item>
                        <item>
                          <widget class="QPushButton" name="btnDelete"><property name="text"><string>🗑️ Supprimer Client</string></property></widget>
                        </item>
                      </layout>
                    </item>
                  </layout>
                </widget>

              </widget> <!-- end tabWidgetMain -->
            </item>

          </layout> <!-- end contentAreaLayout -->
        </item>

      </layout> <!-- end mainLayoutRoot -->
    </widget> <!-- end centralwidget -->

    <widget class="QMenuBar" name="menubar"/>
    <widget class="QStatusBar" name="statusbar"/>
  </widget> <!-- end QMainWindow -->
