     QLineEdit, QComboBox, QDateEdit { background-color: white; border: 1px solid #89c3e2; border-radius: 6px; padding: 8px; color: #0f172a; min-height: 30px; }
     QLabel { font-weight: 600; color: #0f172a; }
     QTableWidget { background-color: white; gridline-color: #90caf9; selection-background-color: #48a4d6; selection-color: white; alternate-background-color: #e9f5fc; border: 1px solid #89c3e2; border-radius: 8px; }
     QHeaderView::section { background-color: #24587a; color: white; font-weight: bold; height: 28px; border: none; }
     QTabWidget::pane { border: 1px solid #89c3e2; border-radius: 6px; }
     QTabBar::tab { background: #e2e8f0; border-radius: 6px; padding: 10px 20px; margin: 4px; color: #0f172a; min-width: 140px; }
     QTabBar::tab:selected { background: #24587a; color: white; }
