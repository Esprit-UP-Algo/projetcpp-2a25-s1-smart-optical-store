         <property name="styleSheet">
          <string notr="true">/* Static design for label_9 */
QLabel#label_9 {
    font-size: 16px;
    font-weight: bold;
    padding: 10px 20px;
    border: 1px solid #93C5FD; /* light blue border */
    border-radius: 12px;
    color: #aa0000;  /* text color */
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #BFDBFE,   /* very light blue top */
        stop:1 #93C5FD    /* soft sky blue bottom */
    );
}

/* Hover effect (static, QLabel hover works) */
QLabel#label_9:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #E0F2FE,   /* almost white-blue */
        stop:1 #BFDBFE
    );
}

/* Pressed effect (optional for QLabel, not clickable by default) */
QLabel#label_9:pressed {
    background-color: #93C5FD; /* flat light blue */
}
QStackedWidget#travaille {
    border: 2px solid black;
    border-radius: 8px; /* Optional: rounded corners */
}
</string>
