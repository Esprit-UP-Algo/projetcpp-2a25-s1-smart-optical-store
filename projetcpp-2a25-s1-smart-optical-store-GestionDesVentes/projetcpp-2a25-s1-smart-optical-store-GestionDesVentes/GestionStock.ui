            <property name="styleSheet">
             <string notr="true">QPushButton {
    font-size: 16px;
    font-weight: bold;
    padding: 10px 20px;
    border: 1px solid #93C5FD; /* light blue border */
    border-radius: 12px;
    color: #1E3A8A;  /* dark blue text */
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #BFDBFE,   /* very light blue top */
        stop:1 #93C5FD    /* soft sky blue bottom */
    );
}

QPushButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #E0F2FE,   /* almost white-blue */
        stop:1 #BFDBFE
    );
}

QPushButton:pressed {
    background-color: #93C5FD; /* flat light blue */
}
</string>
