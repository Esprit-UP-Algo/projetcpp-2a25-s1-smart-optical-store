           <property name="styleSheet">
            <string notr="true">QLineEdit {
    border: 2px solid #8b8ba7;      /* default border */
    border-radius: 12px;            /* rounded shape */
    padding: 6px 10px;
    background-color: #ffffff;
    color: black;
    font-size: 14px;
}

/* when focused */
QLineEdit:focus {
    border: 2px solid #2f2ee9;      /* highlight color */
    background-color: #f0f4ff;      /* light blue background on focus */
    font-weight: bold;              /* text bolder on focus */
}
</string>
