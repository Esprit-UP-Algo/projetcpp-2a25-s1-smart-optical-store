           <property name="styleSheet">
            <string notr="true">/* Static design for pushButton */
QPushButton#pushButton_8 {
    height: 50px;
    width: 120px;
    margin: 5px;
    font-family: Consolas, &quot;Courier New&quot;, monospace;
    font-size: 16px;
    color: #aa0000;
    border: 1px solid #404c5d;
    border-radius: 5px;

    /* Gradient background */
    background: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 #2e2d2d, stop:1 #212121
    );
}

/* Hover state (static colors only) */
QPushButton#pushButton_8:hover {
    color: #d6d6d6;
    background: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 #2a2a2a, stop:1 #1f1f1f
    );
}

/* Pressed state (static colors only) */
QPushButton#pushButton_8:pressed {
    color: #d6d6d6;
    background: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 #1f1f1f, stop:1 #1a1a1a
    );
}
</string>
