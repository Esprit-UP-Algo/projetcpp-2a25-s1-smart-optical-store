      <property name="styleSheet">
       <string notr="true">QPushButton {
    /* 1. Base Orange &quot;Sun&quot; Background (Gradient for a slight shine) */
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ff8c00,   /* Darker orange at the top */
        stop: 1 #ffa500    /* Lighter orange at the bottom */
    );
    color: white; /* White text for contrast */
    border: 2px solid transparent; /* Transparent border initially */
    border-radius: 5px;
    padding: 10px 20px;
    font-weight: bold;
}

QPushButton:hover {
    /* 2. Bright Contour (Border) when the mouse passes over */
    border: 2px solid #ffcc00; /* Bright yellow border (the glow) */
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ff951a,   /* Slightly brighter background on hover */
        stop: 1 #ffb01a
    );
}

QPushButton:pressed {
    /* 3. Darker press effect */
    background-color: rgb(0, 170, 127); /* Solid darker orange */
    border: 2px solid #ffcc00;
}</string>
      </property>
